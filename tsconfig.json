{
  "compilerOptions": {
    "target": "ES2022",
    // This invocation now covers ONLY code that runs under Node: the main process, the
    // preload sources, and src/shared. Everything a browser executes is built elsewhere —
    // the five renderer scripts by esbuild (scripts/bundleRenderer.mjs, type-checked via
    // tsconfig.renderer.json) and the hub by Vite. That separation is what makes node16
    // safe here: while the renderer scripts were emitted by this config, its module format
    // decided how a browser script was emitted, and node16's impliedNodeFormat turned them
    // into CommonJS modules whose `exports` prologue is a ReferenceError in a page.
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts"],
  // All of src/renderer is excluded, not just the hub: nothing a browser runs should be
  // emitted by this config. See the module comment above.
  "exclude": ["node_modules", "dist", "tests", "src/renderer"]
}
